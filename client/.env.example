# Vite only exposes VITE_-prefixed vars, and they are baked into the built JS —
# public values only, never secrets.
#
# You do not create a .env for production by hand. Vite picks the file by mode:
#   npm run dev    -> .env.development   (VITE_API_URL=http://localhost:8000)
#   npm run build  -> .env.production    (VITE_API_URL=https://api.energygrappling.com)
# Both are committed, because the deploy build needs .env.production to exist.
# This file is only a reference for what the keys mean.

VITE_API_URL=http://localhost:8000
VITE_ENVIRONMENT=development
VITE_ENABLE_DEBUG=true
