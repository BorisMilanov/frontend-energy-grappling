{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "energygrappling",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Both hostnames must exist as records in the energygrappling.com zone before the first
  // deploy; wrangler attaches them to this Worker and manages the certificates.
  "routes": [
    { "pattern": "energygrappling.com", "custom_domain": true },
    { "pattern": "www.energygrappling.com", "custom_domain": true }
  ]
}
