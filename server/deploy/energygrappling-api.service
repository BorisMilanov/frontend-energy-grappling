[Unit]
Description=Energy Grappling API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=energygrappling
Group=energygrappling
WorkingDirectory=/opt/energygrappling/server
EnvironmentFile=/opt/energygrappling/server/.env

# --proxy-headers + --forwarded-allow-ips make uvicorn trust X-Forwarded-* from the
# local reverse proxy only, so client IPs and https:// URLs are correct behind Caddy.
ExecStart=/opt/energygrappling/venv/bin/uvicorn main:app \
    --host 127.0.0.1 --port 8000 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1

Restart=always
RestartSec=3

# Hardening. The DB lives outside the code directory so deploys never touch it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/energygrappling

[Install]
WantedBy=multi-user.target
