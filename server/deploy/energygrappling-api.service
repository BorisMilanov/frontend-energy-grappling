[Unit]
Description=Energy Grappling API (Express)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=energygrappling
Group=energygrappling
WorkingDirectory=/opt/energygrappling/server
EnvironmentFile=/opt/energygrappling/server/.env

ExecStart=/usr/bin/node src/index.js

Restart=always
RestartSec=3

# Hardening. The DB lives outside the code directory so deploys never touch it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/energygrappling

[Install]
WantedBy=multi-user.target
