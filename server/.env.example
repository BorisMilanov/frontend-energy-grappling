# Copy to .env. In production every value here must be reviewed.
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the default below.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dev: relative path. Production (systemd unit): sqlite:////var/lib/energygrappling/app.db
DATABASE_URL=sqlite:///./app.db

# There is no CORS setting here on purpose. The allowed browser origins are fixed in code,
# in ALLOWED_ORIGINS at the top of main.py, so they cannot be widened from a .env on the
# server. To add a domain, edit that list and redeploy.
