# Copy to .env. In production every value here must be reviewed.
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the default below.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dev: relative path. Production (systemd unit): sqlite:////var/lib/energygrappling/app.db
DATABASE_URL=sqlite:///./app.db

# Comma-separated exact origins allowed to call the API from a browser.
# Leave this out entirely to use the defaults in app/config.py (prod domains + localhost).
# Setting it REPLACES that list rather than extending it.
CORS_ORIGINS=https://energygrappling.com,https://www.energygrappling.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000
