# Copy to .env. In production every value here must be reviewed.
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is the default below.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dev: relative path. Production (systemd unit): sqlite:////var/lib/energygrappling/app.db
DATABASE_URL=sqlite:///./app.db

# Comma-separated exact origins allowed to call the API from a browser.
# DEVELOPMENT ONLY: when ENVIRONMENT=production the allowed origins are pinned to
# PRODUCTION_CORS_ORIGINS in app/config.py and this variable is ignored. To change the
# production domains, edit that list and redeploy.
# Setting this REPLACES the dev defaults rather than extending them.
CORS_ORIGINS=https://energygrappling.com,https://www.energygrappling.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
