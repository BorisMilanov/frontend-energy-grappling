# Copy to .env. In production every value here must be reviewed.
NODE_ENV=development
PORT=8000

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to start in production while this is the default below.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h

# Dev: relative path. Production: /var/lib/energygrappling/app.db
DATABASE_FILE=./app.db

# There is no CORS setting here on purpose. The allowed browser origins are fixed in code,
# in ALLOWED_ORIGINS in src/config.js, so they cannot be widened from a .env on the server.
# To add a domain, edit that list and redeploy.
